# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env

# Data
data/raw/
data/processed/*
# ...but keep the processed files the deployed API reads at runtime
# (features + feature names for /players & /predict, opp defense + roster for /next-game).
# The larger training_dataset.csv stays ignored — it's only used for model training.
!data/processed/features.csv
!data/processed/feature_names.txt
!data/processed/opp_pos_defense.csv
!data/processed/roster.json

# Models
models/saved/*
# ...but keep the trained model artifacts the deployed API loads at startup
!models/saved/*.pkl
!models/saved/*.json

# Node
node_modules/
dashboard/node_modules/

# OS
.DS_Store

# Logs
*.log