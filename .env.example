# Copy this file to `.env` (which is gitignored) and fill in your keys.
#   cp .env.example .env
# Nothing here is committed — `.env` holds the real secrets locally.

# The Odds API key (https://the-odds-api.com) — used by scraping/odds.py and the
# in-season pipeline to collect NBA game totals/spreads. Without it, odds
# collection is skipped and the Vegas features stay empty.
ODDS_API_KEY=your_odds_api_key_here
