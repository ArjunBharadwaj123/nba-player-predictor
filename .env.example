# Copy this file to `.env` (which is gitignored) and fill in your keys.
#   cp .env.example .env
# Nothing here is committed — `.env` holds the real secrets locally.

# The Odds API key (https://the-odds-api.com). SHARED by the NBA and NFL
# predictors:
#   - NBA: scraping/odds.py collects basketball_nba game totals/spreads.
#   - NFL: nfl/scraping/odds.py collects americanfootball_nfl totals/spreads and
#     player props.
# Both systems function WITHOUT this key — odds features are simply omitted and
# marked as missing (never faked as real zero values).
ODDS_API_KEY=your_odds_api_key_here

# Admin dashboard password (protects /admin and the /admin/* API). Set this in
# the Render environment (never commit the real value). If unset, the admin API
# returns 503 (not configured).
ADMIN_PASSWORD=change_me

# Weight multiplier applied to the most-recent NFL season during training, so
# the current season counts more as it unfolds (default 2.0).
# NFL_CURRENT_SEASON_WEIGHT=2.0

# ── NFL pipeline configuration (all optional) ─────────────────────────────────
# Season range for NFL data collection / training. Production defaults to
# 2018..latest; set these to trim runtime/memory.
#   NFL_SEASONS=2021,2022,2023,2024   # explicit list (overrides the range)
#   NFL_START_SEASON=2018
#   NFL_END_SEASON=2024
# Development mode uses a smaller season range and clearly labels artifacts as
# "dev" (not production accuracy):
#   NFL_DEV_MODE=1

# Sportradar (FUTURE, optional): a possible source for more timely injuries,
# inactives, depth charts and live game data. NOT required for v1 — leave unset.
# SPORTRADAR_API_KEY=
